{
  "name": "sistema-chepola",
  "version": "21.0.0",
  "description": "Sistema Chepola - API REST con Express",
  "main": "src/server.js",
  "scripts": {
    "build": "npm install --include=dev --prefix frontend && npm run build --prefix frontend",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrar": "node scripts/migrar.js",
    "alta": "node scripts/alta-instancia.js",
    "test": "node --test \"test/**/*.test.js\"",
    "dev:all": "concurrently -n API,WEB -c cyan,magenta \"npm run dev\" \"npm run dev --prefix frontend\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.5",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "soap": "^1.10.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.4"
  }
}
